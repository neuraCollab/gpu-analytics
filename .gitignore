# Файлы, которые не нужно класть в git.
# Важно: в .gitignore комментарий допустим только на отдельной строке, начинающейся с «#».

# Виртуальное окружение Python — создаётся заново командой uv venv.
.venv/
# Скомпилированные файлы Python.
__pycache__/
*.pyc
# Кэш pytest.
.pytest_cache/
# Сгенерированные и скачанные данные: большие и воспроизводятся скриптами.
# Ведущий «/» — только папка data в корне проекта. Без него git проигнорировал бы
# и src/gpu_analytics/data/ с кодом генерации данных.
/data/
# Результаты прогонов и паспорта: храним выборочно (сводные таблицы — отдельно).
/results/*.csv
/results/*.json
# Временные базы DuckDB.
*.duckdb
